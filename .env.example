# Bambu Lab Printer - LAN credentials.
# You don't need to fill this in by hand — the easier path is to register the
# server with your MCP client without any env vars and let the `setup_printer`
# tool write this file for you. See README "Quick start".
#
# The server reads this file from its config directory:
#   Windows: %APPDATA%\mcp-server-for-bambu\.env
#   macOS:   ~/Library/Application Support/mcp-server-for-bambu/.env
#   Linux:   ~/.config/mcp-server-for-bambu/.env
# (or $BAMBU_CONFIG_DIR/.env). Env vars set by the MCP client take precedence.
#
# Where to find each value on the printer touchscreen:
#   Settings -> WLAN     -> tap (i) next to the connected network        => IP
#   Settings -> Device   -> Device Info -> Serial Number                 => SERIAL
#   Settings -> WLAN     -> LAN Mode Liveview (must be ON, 8 chars)      => ACCESS_CODE

BAMBU_IP=192.168.1.100
BAMBU_SERIAL=01P00AXXXXXXXXX
BAMBU_ACCESS_CODE=XXXXXXXX

# Optional: register only the read tools (no pause/cancel/heat/G-code).
# BAMBU_READ_ONLY=1

# Optional: where to store the maintenance ledger.
# Defaults to maintenance.json in the config directory above.
# MAINTENANCE_LEDGER_PATH=/absolute/path/to/maintenance.json
